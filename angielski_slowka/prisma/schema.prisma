generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CardType {
  TRANSLATION
  DEFINITION
}

model Deck {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String?  @db.Text
  title       String   @db.VarChar(90)
  description String?  @db.VarChar(240)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cards       Card[]

  @@index([ownerId, updatedAt])
}

model Card {
  id           String   @id @default(uuid()) @db.Uuid
  deckId       String   @db.Uuid
  deck         Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front        String   @db.VarChar(180)
  back         String   @db.VarChar(1000)
  cardType     CardType @default(TRANSLATION)
  masteryLevel Int      @default(0)
  lastReviewed DateTime?
  createdAt    DateTime @default(now())

  @@index([deckId])
}
