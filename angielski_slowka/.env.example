# Neon (neon env pull provisions these in .env.local automatically):
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Backwards compatibility with Vercel Postgres integrations:
# POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Neon Auth: BASE_URL comes from `neon deploy`; create a 32+ character cookie secret.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Neon Object Storage credentials are supplied by `neon deploy` / `neon env pull`.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
